{
  "name": "blitzcue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild client/main.js --bundle --format=esm --target=es2022 --outfile=public/app.js",
    "dev": "npm run db:local && npm run build && wrangler dev",
    "deploy": "npm run db:remote && npm run build && wrangler deploy --secrets-file .prod.vars",
    "register:command": "node --env-file=.prod.vars scripts/register-command.mjs",
    "db:local": "wrangler d1 migrations apply blitzcue --local",
    "db:remote": "wrangler d1 migrations apply blitzcue --remote",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.4.0",
    "@picocss/pico": "^2.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0",
    "wrangler": "^4.0.0"
  }
}
